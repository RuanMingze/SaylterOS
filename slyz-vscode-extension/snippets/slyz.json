{
  "SLYZ v2 程序骨架": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    ${1:// 在这里写代码}",
      "    $0",
      "}",
      ""
    ],
    "description": "函数入口；存在 main() 时，顶层语句先执行，再调用 main"
  },
  "变量声明": {
    "prefix": "let",
    "body": ["let ${1:name} = ${2:0}", "$0"],
    "description": "声明局部变量"
  },
  "函数定义": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) {",
      "    $0",
      "}"
    ],
    "description": "定义函数"
  },
  "if / else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "条件分支"
  },
  "while 循环": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "while 循环"
  },
  "for 区间循环": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "    $0",
      "}"
    ],
    "description": "按区间迭代"
  },
  "遍历数组": {
    "prefix": "foreach",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ],
    "description": "遍历数组或区间"
  },
  "输出一行": {
    "prefix": "println",
    "body": ["println(${1:\"text\"})", "$0"],
    "description": "打印并换行"
  },
  "读取文件": {
    "prefix": "readfile",
    "body": ["let ${1:text} = fs.read(${2:\"path\"})", "$0"],
    "description": "读取整个文件为字符串"
  },
  "写入文件": {
    "prefix": "writefile",
    "body": ["fs.write(${1:\"path\"}, ${2:text})", "$0"],
    "description": "写入整个文件"
  },
  "打开窗口": {
    "prefix": "winopen",
    "body": ["let ${1:w} = win.open(${2:\"Title\"}, ${3:640}, ${4:480})", "$0"],
    "description": "打开 GUI 窗口（需要 GUI 宿主）"
  },
  "事件循环": {
    "prefix": "eventloop",
    "body": [
      "while true {",
      "    let ${1:ev} = event.poll()",
      "    if ${1:ev} != nil {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "窗口事件轮询"
  }
}
