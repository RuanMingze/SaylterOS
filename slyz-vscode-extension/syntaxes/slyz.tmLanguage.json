{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-tmgrammar-test/master/syntaxes/README.md",
  "name": "SLYZ",
  "scopeName": "source.slyz",
  "patterns": [
    { "include": "#gui-marker" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#gui-directives" },
    { "include": "#actions" },
    { "include": "#placeholders" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#commands" }
  ],
  "repository": {
    "gui-marker": {
      "patterns": [
        {
          "match": "^\\s*(#gui)\\b",
          "name": "keyword.other.gui-marker.slyz",
          "captures": {
            "1": { "name": "entity.name.tag.slyz-gui" }
          }
        }
      ]
    },
    "gui-directives": {
      "patterns": [
        {
          "match": "^\\s*(title|size|label|input|button|space|hr)\\b",
          "captures": {
            "1": { "name": "keyword.other.gui.slyz" }
          }
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "match": "(->)\\s*(close|set:|open:|shell:)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.slyz" },
            "2": { "name": "support.function.action.slyz" }
          }
        }
      ]
    },
    "placeholders": {
      "patterns": [
        {
          "match": "\\{[A-Za-z_][A-Za-z0-9_]*\\}",
          "name": "variable.other.placeholder.slyz"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.slyz"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "\"(?:\\\\.|[^\\\"])*\"",
          "name": "string.quoted.double.slyz"
        },
        {
          "match": "'(?:\\\\.|[^\\'])*'",
          "name": "string.quoted.single.slyz"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|endif|yes|no|echo|ask|run|dir|ls|exit|quit|write|read|remove|help|clear|version|uname|whoami|date|mem|reboot|gui|ps)\\b",
          "name": "keyword.control.slyz"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.slyz"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "match": "^\\s*[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.slyz"
        }
      ]
    }
  }
}
