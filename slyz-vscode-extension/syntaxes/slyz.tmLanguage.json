{
  "name": "SLYZ",
  "scopeName": "source.slyz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#modules" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.slyz"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.slyz"
        },
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.number-sign.slyz"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.slyz",
          "patterns": [
            {
              "match": "\\\\[nrt\\\\\"0]",
              "name": "constant.character.escape.slyz"
            },
            {
              "match": "\\\\x[0-9A-Fa-f]{2}",
              "name": "constant.character.escape.hex.slyz"
            },
            {
              "match": "\\\\u\\{[0-9A-Fa-f]+\\}",
              "name": "constant.character.escape.unicode.slyz"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9A-Fa-f_]+\\b",
          "name": "constant.numeric.hex.slyz"
        },
        {
          "match": "\\b0b[01_]+\\b",
          "name": "constant.numeric.binary.slyz"
        },
        {
          "match": "\\b\\d[\\d_]*\\b",
          "name": "constant.numeric.decimal.slyz"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(let|fn)\\b",
          "name": "storage.type.slyz"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|for|in|break|continue|return)\\b",
          "name": "keyword.control.slyz"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "match": "\\b(true|false|nil)\\b",
          "name": "constant.language.slyz"
        },
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.word.slyz"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "match": "\\b(fs|cfg|time|os|win|gfx|event)\\b(?=\\s*\\.)",
          "name": "support.class.module.slyz"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(print|println|eprint|len|str|int|substr|index_of|upper|lower|trim|replace|split|join|abs|min|max|clamp|sign|random|array|push|pop|range|typeof|str_at|ord|chr|hex|bin)\\b(?=\\s*\\()",
          "name": "support.function.builtin.slyz"
        },
        {
          "match": "\\b(read|write|exists|list|remove|mkdir|get|set|keys|now|ms|text|date|sleep|exec|exit|beep|open|clear|rect|frame|line|circle|flush|poll|wait)\\b(?=\\s*\\()",
          "name": "support.function.method.slyz"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\+\\+|--|\\.\\.)",
          "name": "keyword.operator.slyz"
        },
        {
          "match": "(\\+|-|\\*|/|%|=|<|>|!|\\[|\\])",
          "name": "keyword.operator.slyz"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.slyz"
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "variable.other.slyz"
        }
      ]
    }
  }
}
