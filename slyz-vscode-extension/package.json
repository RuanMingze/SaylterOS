{
  "name": "saylter-slyz",
  "displayName": "Saylter SLYZ",
  "description": "SLYZ v2 语言支持：语法高亮、代码片段，以及由 slyzc 提供的实时语法检查。",
  "version": "0.3.0",
  "publisher": "saylter-os",
  "repository": {
    "type": "git",
    "url": "https://github.com/RuanMingze/SaylterOS.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:slyz"
  ],
  "contributes": {
    "languages": [
      {
        "id": "slyz",
        "aliases": ["SLYZ", "slyz"],
        "extensions": [".slyzcode"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slyz",
        "scopeName": "source.slyz",
        "path": "./syntaxes/slyz.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "slyz",
        "path": "./snippets/slyz.json"
      }
    ],
    "configuration": {
      "title": "SLYZ",
      "properties": {
        "slyz.compilerPath": {
          "type": "string",
          "default": "",
          "description": "slyzc.exe 的路径。留空时依次查找工作区的 build\\slyzc.exe、tools\\slyzc\\build\\slyzc.exe 与扩展自带的 bin\\slyzc.exe。"
        },
        "slyz.checkDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "编辑后延迟多少毫秒再请求语法检查（0 表示每次输入都检查）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --out saylter-slyz.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  }
}
