# ============================================================
# guiwin3.slyz3 - 窗口与绘图骨架（SLYZ v3）
# ------------------------------------------------------------
# 用原始 gfx/event 接口实现的计数窗口，验证 v3 的窗口 API
# 与 v2 行为一致（窗口尺寸、标题、关闭事件）。
# ============================================================

state ticks = 0

# ---- 主题色 ----
state c_bg = 0x0B1017
state c_card = 0x141C27
state c_text = 0xE9EFF7
state c_dim = 0x8EA0B4
state c_border = 0x2B3949

fn load_theme() {
    c_bg = ui.theme(0)
    c_card = ui.theme(2)
    c_text = ui.theme(6)
    c_dim = ui.theme(7)
    c_border = ui.theme(5)
}

fn draw() {
    gfx.clear(c_bg)
    gfx.rect(0, 0, 640, 56, c_card)
    gfx.text(20, 16, "SLYZ Window", c_text)
    gfx.text(20, 92, "ticks = " + str(ticks), c_dim)
    gfx.text(20, 132, "width = " + str(win.width(0)), c_dim)
    gfx.text(20, 172, "height = " + str(win.height(0)), c_dim)
    gfx.frame(16, 76, 608, 328, c_border, 1)
    gfx.flush()
}

fn main() {
    let handle = win.open("SLYZ Window", 640, 420)
    if handle < 0 {
        return
    }
    load_theme()

    let running = 1
    while running == 1 {
        draw()
        ticks = ticks + 1

        let ev = event.wait(16)
        if ev != nil {
            let kind = ev.at(0)
            if kind == 5 {
                running = 0
            }
            if kind == 1 && ev.at(1) == 27 {
                running = 0
            }
        }
    }

    win.close(0)
    println("window closed after " + str(ticks) + " ticks")
}

on start {
    main()
}
