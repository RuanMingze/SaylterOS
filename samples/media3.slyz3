# ============================================================
# media3.slyz3 - 媒体播放器（SLYZ v3）
# ------------------------------------------------------------
# 双击 .mp3 时由桌面把路径放进 audio 待播放槽，应用用
# media.request() 取走并播放。播放状态全部来自内核音频服务。
# ============================================================

state W = 576
state H = 474

state path = ""
state msg = ""
state msg_until = 0

# ---- 主题色 ----
state c_bg = 0x0B1017
state c_card = 0x141C27
state c_field = 0x1B2532
state c_raise = 0x223041
state c_text = 0xE9EFF7
state c_dim = 0x8EA0B4
state c_accent = 0x2F6FE0
state c_accent3 = 0x4F8EF7
state c_ok = 0x34D399
state c_warn = 0xFBBF24

fn load_theme() {
    c_bg = ui.theme(0)
    c_card = ui.theme(2)
    c_field = ui.theme(3)
    c_raise = ui.theme(4)
    c_text = ui.theme(6)
    c_dim = ui.theme(7)
    c_accent = ui.theme(9)
    c_accent3 = ui.theme(8)
    c_ok = ui.theme(11)
    c_warn = ui.theme(13)
}

fn base_name(p) {
    let slash = 0
    let i = 0
    while i < len(p) {
        if str_at(p, i) == "\\" {
            slash = i + 1
        }
        i = i + 1
    }
    return substr(p, slash, len(p) - slash)
}

fn fmt_time(ms) {
    if ms < 0 {
        ms = 0
    }
    let total = ms / 1000
    let m = total / 60
    let s = total % 60
    let st = str(s)
    if s < 10 {
        st = "0" + st
    }
    return str(m) + ":" + st
}

fn draw_button(x, y, w, h, label, primary) {
    let bg = c_field
    let fg = c_text
    if primary != 0 {
        bg = c_accent
        fg = 0xFFFFFF
    }
    gfx.rect(x, y, w, h, bg)
    let tw = gfx.text_width(label)
    gfx.text(x + (w - tw) / 2, y + (h - 32) / 2, label, fg)
}

fn draw() {
    gfx.clear(c_bg)

    let st = audio.state()
    let pos = audio.position()
    let dur = audio.duration()
    let vol = audio.volume()

    gfx.text(20, 16, "Media Player", c_text)

    let name = "No media file"
    if path != "" {
        name = base_name(path)
    }
    if len(name) > 32 {
        name = substr(name, 0, 32) + "..."
    }
    gfx.text(20, 52, name, c_dim)

    let cx = W / 2
    let cy = 150
    gfx.circle(cx, cy, 78, c_card)
    gfx.circle(cx, cy, 70, c_field)
    gfx.circle(cx, cy, 54, c_raise)
    gfx.circle(cx, cy, 34, c_field)
    gfx.circle(cx, cy, 14, c_accent)
    gfx.circle(cx, cy, 5, c_bg)

    let bar_x = 20
    let bar_y = 262
    let bar_w = W - 40
    gfx.rect(bar_x, bar_y, bar_w, 10, c_raise)
    if dur > 0 {
        let filled = bar_w * pos / dur
        if filled > bar_w {
            filled = bar_w
        }
        if filled > 0 {
            gfx.rect(bar_x, bar_y, filled, 10, c_accent3)
        }
    }

    gfx.text(bar_x, bar_y + 22, fmt_time(pos), c_dim)
    let dt = fmt_time(dur)
    gfx.text(bar_x + bar_w - gfx.text_width(dt), bar_y + 22, dt, c_dim)

    let play_label = "Play"
    if st == 1 {
        play_label = "Pause"
    } else if st == 2 {
        play_label = "Resume"
    }
    draw_button(20, 330, 170, 52, play_label, 1)
    draw_button(206, 330, 120, 52, "Stop", 0)
    draw_button(342, 330, 70, 52, "-", 0)
    draw_button(422, 330, 70, 52, "+", 0)

    gfx.text(20, 404, "Volume", c_dim)
    gfx.rect(120, 406, 340, 10, c_raise)
    let vw = 340 * vol / 100
    if vw > 0 {
        gfx.rect(120, 406, vw, 10, c_ok)
    }
    let vt = str(vol) + "%"
    gfx.text(476, 396, vt, c_text)

    if msg != "" && time.ms() < msg_until {
        gfx.text(20, 436, msg, c_warn)
    }

    gfx.flush()
}

fn toggle_play() {
    let st = audio.state()
    if st == 1 {
        audio.pause(1)
    } else if st == 2 {
        audio.pause(0)
    } else if path != "" {
        if audio.play(path) != 0 {
            msg = "Cannot open this file"
            msg_until = time.ms() + 2500
        }
    }
}

fn handle_click(px, py) {
    if py >= 330 && py <= 382 {
        if px >= 20 && px < 190 {
            toggle_play()
            return
        }
        if px >= 206 && px < 326 {
            audio.stop()
            return
        }
        if px >= 342 && px < 412 {
            let v = audio.volume() - 5
            if v < 0 {
                v = 0
            }
            audio.set_volume(v)
            return
        }
        if px >= 422 && px < 492 {
            let v = audio.volume() + 5
            if v > 100 {
                v = 100
            }
            audio.set_volume(v)
            return
        }
    }

    if py >= 396 && py <= 424 {
        if px >= 120 && px <= 460 {
            let v = (px - 120) * 100 / 340
            audio.set_volume(v)
            return
        }
    }
}

fn handle_key(ch) {
    if ch == 32 {
        toggle_play()
    }
}

fn main() {
    let handle = win.open("Media Player", 600, 540)
    if handle < 0 {
        return
    }
    load_theme()

    let pending = media.request()
    if pending != "" {
        path = pending
    }

    if path != "" {
        if audio.play(path) != 0 {
            msg = "Cannot open this file"
            msg_until = time.ms() + 2500
        }
    }

    let running = 1
    while running == 1 {
        draw()

        let ev = event.poll()
        if ev != nil {
            let kind = ev.at(0)
            if kind == 3 {
                handle_click(ev.at(1), ev.at(2))
            } else if kind == 1 {
                handle_key(ev.at(1))
            } else if kind == 5 {
                audio.stop()
                running = 0
            }
        }

        if audio.state() == 0 && audio.position() >= audio.duration() && audio.duration() > 0 {
            msg = "Playback finished"
            msg_until = time.ms() + 2500
        }
    }
}

on start {
    main()
}
