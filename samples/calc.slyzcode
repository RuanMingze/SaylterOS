// ============================================================
// calc.slyzcode - 桌面计算器（SLYZ 独立应用）
// ------------------------------------------------------------
// 这是第一个从内核 gui.c 迁移到 SLYZ 的程序。它只通过窗口、
// 绘图与事件接口工作，不链接任何内核内部函数：
//   - 崩溃只会终止本程序的虚拟机，其他窗口继续运行；
//   - 布局、状态机、按键处理全部在这个文件里，修改无需重编内核。
//
// 运算为 64 位整数，与内核内置计算器保持一致；除零进入 Error 态，
// 下一次输入数字时自动恢复。
// ============================================================

let BW = 88
let BH = 56
let GAP = 8
let BX = 12
let BY = 140

let labels = [
    "C", "+/-", "%", "/",
    "7", "8", "9", "*",
    "4", "5", "6", "-",
    "1", "2", "3", "+",
    "0", ".", "<", "="
]

let acc = 0
let cur = "0"
let op = 0
let fresh = 1
let err = 0

fn reset_all() {
    acc = 0
    cur = "0"
    op = 0
    fresh = 1
    err = 0
}

fn input_text(s) {
    if err != 0 {
        reset_all()
    }
    if fresh != 0 {
        cur = ""
        fresh = 0
    }
    if len(cur) < 16 {
        cur = cur + s
    }
}

fn apply() {
    if err != 0 {
        return
    }

    let v = int(cur)
    if op == 1 {
        acc = acc + v
    } else if op == 2 {
        acc = acc - v
    } else if op == 3 {
        acc = acc * v
    } else if op == 4 {
        if v == 0 {
            err = 1
            cur = "Error"
            op = 0
            fresh = 1
            return
        }
        acc = acc / v
    } else {
        acc = v
    }

    op = 0
    cur = str(acc)
    fresh = 1
}

fn press(idx) {
    if idx < 0 {
        return
    }

    let lab = labels.at(idx)

    if lab == "C" {
        reset_all()
        return
    }
    if lab == "+/-" {
        cur = str(-int(cur))
        fresh = 0
        return
    }
    if lab == "%" {
        cur = str(int(cur) / 100)
        fresh = 0
        return
    }
    if lab == "/" {
        apply()
        op = 4
        fresh = 1
        return
    }
    if lab == "*" {
        apply()
        op = 3
        fresh = 1
        return
    }
    if lab == "-" {
        apply()
        op = 2
        fresh = 1
        return
    }
    if lab == "+" {
        apply()
        op = 1
        fresh = 1
        return
    }
    if lab == "=" {
        apply()
        return
    }
    if lab == "<" {
        if len(cur) > 1 {
            cur = substr(cur, 0, len(cur) - 1)
        } else {
            cur = "0"
        }
        fresh = 0
        return
    }
    if lab == "." {
        return
    }

    input_text(lab)
}

fn press_key(ch) {
    if ch >= 48 && ch <= 57 {
        input_text(chr(ch))
        return
    }
    if ch == 43 {
        apply()
        op = 1
        fresh = 1
        return
    }
    if ch == 45 {
        apply()
        op = 2
        fresh = 1
        return
    }
    if ch == 42 {
        apply()
        op = 3
        fresh = 1
        return
    }
    if ch == 47 {
        apply()
        op = 4
        fresh = 1
        return
    }
    if ch == 13 || ch == 61 {
        apply()
        return
    }
    if ch == 8 || ch == 127 {
        if len(cur) > 1 {
            cur = substr(cur, 0, len(cur) - 1)
        } else {
            cur = "0"
        }
        fresh = 0
        return
    }
    if ch == 99 || ch == 67 {
        reset_all()
        return
    }
    if ch == 27 {
        win.close(0)
    }
}

fn hit(px, py) {
    if px < BX || py < BY {
        return -1
    }

    let step_x = BW + GAP
    let step_y = BH + GAP
    let lx = px - BX
    let ly = py - BY
    let col = lx / step_x
    let row = ly / step_y

    if col > 3 || row > 4 {
        return -1
    }
    if lx % step_x >= BW || ly % step_y >= BH {
        return -1
    }

    return row * 4 + col
}

fn draw() {
    gfx.clear(0x0B1017)

    gfx.rect(12, 12, 376, 100, 0x0C141E)
    gfx.frame(12, 12, 376, 100, 0x2B3949, 1)

    let dw = gfx.text_width(cur)
    gfx.text(376 - dw, 46, cur, 0xE9EFF7)

    for i in 0..20 {
        let col = i % 4
        let row = i / 4
        let x = BX + col * (BW + GAP)
        let y = BY + row * (BH + GAP)

        let bg = 0x1B2532
        if col == 3 {
            bg = 0x2F6FE0
        }
        if i == 0 {
            bg = 0x7F1D1D
        }

        gfx.rect(x, y, BW, BH, bg)

        let lab = labels.at(i)
        let lw = gfx.text_width(lab)
        let fg = 0xE9EFF7
        if col == 3 {
            fg = 0xFFFFFF
        }
        gfx.text(x + (BW - lw) / 2, y + 16, lab, fg)
    }

    gfx.flush()
}

fn main() {
    let handle = win.open("Calculator", 420, 560)
    if handle < 0 {
        return
    }

    let running = 1
    while running {
        draw()

        let ev = event.poll()
        if ev != nil {
            let kind = ev.at(0)
            if kind == 3 {
                press(hit(ev.at(1), ev.at(2)))
            }
            if kind == 1 {
                press_key(ev.at(1))
            }
        }
    }
}
