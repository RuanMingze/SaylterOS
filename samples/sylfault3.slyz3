# ============================================================
# sylfault3.slyz3 - SylFault 图形版（SLYZ v3）
# ------------------------------------------------------------
# v3 的新写法：
#   - screen { ... } 声明界面，不再手写绝对坐标；
#   - style { ... } 使用 CSS 选择器/层叠与 hover 过渡；
#   - on click(id) / on tick 处理事件与刷新；
#   - 布局默认撑开，文本自动换行，窗口装不下时整页滚动。
#
# 故障按钮采用"点两次确认"：第一次选中，第二次才注入，
# 避免误触让整台机器立刻停机。
# ============================================================

state leaked = 0
state pending = -1
state message = "Pick a fault. Click the same button twice to confirm."

screen SylFault {
    column gap=12 padding=16 {
        row gap=12 {
            text "SylFault" class="title"
            spacer grow=1
            text "SLYZ v3" class="badge"
        }
        text "Controlled crash, dump and memory leak laboratory" class="muted"

        panel {
            row gap=24 {
                column gap=2 {
                    text "HEAP" class="label"
                    text "0 KB" id="heap" class="value"
                }
                column gap=2 {
                    text "LEAKED" class="label"
                    text "0 KB" id="leaked" class="value"
                }
                column gap=2 {
                    text "DUMP" class="label"
                    text "OFF" id="dump" class="value"
                }
                column gap=2 {
                    text "SERIAL" class="label"
                    text "OFF" id="serial" class="value"
                }
            }
        }

        text "FAULT INJECTION" class="section"
        grid cols=3 gap=8 {
            button id="f0" text="1. Manual 0xE2" class="danger"
            button id="f1" text="2. Div/0 0x1E" class="danger"
            button id="f2" text="3. Null 0x50" class="danger"
            button id="f3" text="4. Bad op 0x7F" class="danger"
            button id="f4" text="5. Double free 0xC2" class="danger"
            button id="f5" text="6. Stack 0xF7" class="danger"
            button id="f6" text="7. OOM 0xE4" class="danger"
            button id="f7" text="8. IRQL 0x0A" class="danger"
            button id="f8" text="9. Security 0x139" class="danger"
            button id="f9" text="10. Corruption 0x109" class="danger"
            button id="f10" text="11. Driver 0xD1" class="danger"
        }

        text "MEMORY AND DUMPS" class="section"
        row gap=8 {
            button id="leak" text="Leak +1 MB"
            button id="free" text="Free leaked"
            button id="dumpnow" text="Write dump now" class="primary"
        }
        row gap=8 {
            button id="toggledump" text="Dump on crash: OFF"
            button id="toggleserial" text="Serial log: OFF"
        }

        text "Pick a fault. Click the same button twice to confirm." id="status" class="muted"
    }
}

style {
    .title { font-size: 48; color: #E9EFF7; }
    .badge { color: #7FB2FF; }
    .muted { color: #8EA0B4; }
    .label { color: #5A6B7E; }
    .value { color: #E9EFF7; }
    .section { color: #8EA0B4; }

    panel {
        background: #141C27;
        border: 1px solid #2B3949;
        border-radius: 12px;
        padding: 12px 16px;
    }

    button {
        background: #1B2532;
        border: 1px solid #2B3949;
        border-radius: 10px;
        padding: 9px 12px;
        color: #E9EFF7;
        transition: 140;
    }
    button:hover { background: #22384F; border-color: #4F8EF7; }
    button:pressed { background: #2F6FE0; border-color: #4F8EF7; }
    button.primary { background: #2F6FE0; border-color: #4F8EF7; }
    button.primary:hover { background: #3B7BF0; }
    button.danger { background: #3A1A1C; border-color: #7F1D1D; }
    button.danger:hover { background: #7F1D1D; border-color: #F87171; }
}

on start {
    win.title(0, "SylFault")
}

on click(id) {
    if id == "leak" {
        leaked = fault.leak(1024)
        message = "Leaked memory is now " + str(leaked) + " KB."
        return
    }
    if id == "free" {
        let freed = fault.leak_free()
        leaked = 0
        message = "Released " + str(freed) + " KB."
        return
    }
    if id == "dumpnow" {
        let rc = fault.dump()
        if rc == 0 {
            message = "Dump written to system\\crash."
        } else {
            message = "Dump failed: SlyzFS is not writable."
        }
        return
    }
    if id == "toggledump" {
        if fault.get("dump") == "1" {
            fault.set("dump", "0")
        } else {
            fault.set("dump", "1")
        }
        message = "Dump on crash updated."
        return
    }
    if id == "toggleserial" {
        if fault.get("serial_to_disk") == "1" {
            fault.set("serial_to_disk", "0")
        } else {
            fault.set("serial_to_disk", "1")
        }
        message = "Serial log setting updated."
        return
    }

    let kind = -1
    if id == "f0" { kind = 0 }
    else if id == "f1" { kind = 1 }
    else if id == "f2" { kind = 2 }
    else if id == "f3" { kind = 3 }
    else if id == "f4" { kind = 4 }
    else if id == "f5" { kind = 5 }
    else if id == "f6" { kind = 6 }
    else if id == "f7" { kind = 7 }
    else if id == "f8" { kind = 8 }
    else if id == "f9" { kind = 9 }
    else if id == "f10" { kind = 10 }

    if kind >= 0 {
        if pending == kind {
            message = "Injecting fault " + str(kind + 1) + "..."
            ui.set("status", message)
            fault.trigger(kind)
            message = "Fault returned without halting (unknown kind)."
        } else {
            pending = kind
            message = "Click fault " + str(kind + 1) + " again to confirm."
        }
    }
}

on key(ch) {
    if ch == 27 {
        win.close(0)
    }
}

on tick {
    ui.set("heap", "Heap " + str(os.info(2) / 1024) + " KB")
    ui.set("leaked", str(fault.get("leak_kb")) + " KB")

    let d = "OFF"
    if fault.get("dump") == "1" {
        d = "ON"
    }
    let s = "OFF"
    if fault.get("serial_to_disk") == "1" {
        s = "ON"
    }
    ui.set("dump", d)
    ui.set("serial", s)
    ui.set("dumpbtn", "Dump on crash: " + d)
    ui.set("serialbtn", "Serial log: " + s)
    ui.set("status", message)
}
